{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amazon",
  "main": "./src/index.js",
  "compatibility_date": "2026-10-06",
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
